							<Panel id="dr0_tn" class="dr-n" hittest="false">
								<Panel class="dr-nin" hittest="false">
									<Label class="dr-nb" hittest="false" text="{s:dr0_t}" />
									<Label class="dr-ns" hittest="false" text="{s:dr0_th}" />
								</Panel>
							</Panel>
						</Panel>
						<Label id="dr0_hp" class="dr-hp" hittest="false" text="{s:dr0_hp}" />
